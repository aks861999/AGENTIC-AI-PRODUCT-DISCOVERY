#  Copy this file to .env and fill in your values ──────────────────────────
# cp .env.example .env
# Every variable here is read by shared/config/settings.py. Run all commands
# from the repo root: .env and the data paths below are resolved from there.

# ── Data (ingestion only) ─────────────────────────────────────────────────────
HOME_DEPOT_DESC_PATH=volumes/home_depot_data/product_descriptions_50k.csv
HOME_DEPOT_ATTR_PATH=volumes/home_depot_data/attributes_50k.csv

# ── OpenSearch ────────────────────────────────────────────────────────────────
# Amazon OpenSearch Service example; for a local Docker node use
# localhost / 9200 / false / false and leave user + password unset.
OPENSEARCH_HOST=your-domain-name.eu-north-1.es.amazonaws.com
OPENSEARCH_PORT=443
OPENSEARCH_USE_SSL=true
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=change_me

# ── Index ─────────────────────────────────────────────────────────────────────
INDEX_NAME=products

# ── Embedding model ───────────────────────────────────────────────────────────
# The index's vector dimension is taken from this model when the index is created.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
BATCH_SIZE=128

# ── Bulk indexing ─────────────────────────────────────────────────────────────
# Documents per bulk request; smaller eases load on a small cluster
CHUNK_SIZE=250

# ── LLMs ──────────────────────────────────────────────────────────────────────
# Gemini is tried first, then Groq. With neither key, /nl-search uses a regex
# stub parser and /chat returns an error.
# Gemini key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-key
LLM_MODEL=gemini-2.5-flash

# Groq key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile

# Query parser temperature (the chat agent uses 0.3)
LLM_TEMPERATURE=0.0

# Gemini client retries; 0 lets a quota error fall through to Groq at once
MAX_RETRIES=0

# ── API ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Search tuning ─────────────────────────────────────────────────────────────
# Results per page when a request doesn't set size
DEFAULT_SIZE=10
# kNN candidates for hybrid and semantic search
KNN_K=500
# Score weights in the hybrid search pipeline (scaled to sum to 1);
# applied when ingestion runs and when the API starts
HYBRID_BM25_WEIGHT=0.4
HYBRID_KNN_WEIGHT=0.6
